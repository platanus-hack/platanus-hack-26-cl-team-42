# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
DJANGO_DATABASE_URL=sqlite:///db.sqlite3
DJANGO_TIME_ZONE=UTC
# Default language (BCP 47 / locale code). Must be one of settings.LANGUAGES;
# the active language is still negotiated per-request by LocaleMiddleware.
DJANGO_LANGUAGE_CODE=en-us
DJANGO_LOG_LEVEL=INFO
DJANGO_ADMIN_PATH=admin/
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_FRONTEND_URL=http://localhost:3000

# Company route-prefix convention. Keep this set to "-" so backend routes
# are served under /-/, e.g. /-/api/ and /-/_health/.
DJANGO_URL_PREFIX=-

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SUBJECT_PREFIX=
EMAIL_DEFAULT_FROM=root@localhost
EMAIL_SERVER=root@localhost

# Auth / allauth
# Add provider-specific settings here as needed.
