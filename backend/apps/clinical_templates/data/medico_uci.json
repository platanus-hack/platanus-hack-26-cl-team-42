{
  "x-plantilla": {
    "slug": "medico_uci",
    "nombre": "Registro médico UCI",
    "profesion": "medico",
    "descripcion": "Ingreso, evolución, evento agudo o egreso escrito por el médico intensivista o residente de UCI.",
    "tipos_registro": [
      "ingreso_uci",
      "evolucion",
      "evento_agudo",
      "procedimiento",
      "ronda_interdisciplinaria",
      "egreso_uci"
    ],
    "especialidad_obligatoria": false,
    "instrucciones_llm": "Plantilla médica UCI. Organiza la evaluación por sistemas en 'valoracion_por_sistemas'.\nCompleta 'ingreso' solo si es la nota de ingreso a UCI y 'egreso' solo si es la nota de egreso; en otro caso déjalos en null.\nLas 'metas_del_dia' son objetivos explícitos (PAM, RASS, balance, SatO2...). Las órdenes concretas van en 'indicaciones'."
  },
  "title": "Registro médico UCI",
  "description": "Ingreso, evolución, evento agudo o egreso escrito por el médico intensivista o residente de UCI.",
  "properties": {
    "ingreso": {
      "type": [
        "object",
        "null"
      ],
      "description": "Datos exclusivos de la nota de ingreso a UCI. null si no es ingreso.",
      "properties": {
        "motivo_ingreso_uci": {
          "type": [
            "string",
            "null"
          ],
          "description": "Motivo de ingreso a UCI."
        },
        "procedencia": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "urgencia",
            "pabellon",
            "sala",
            "otra_uci",
            "otro_hospital",
            "otro",
            null
          ],
          "description": "Desde dónde ingresa."
        },
        "antecedentes": {
          "type": [
            "object",
            "null"
          ],
          "description": "Antecedentes del paciente.",
          "properties": {
            "morbidos": {
              "type": "array",
              "description": "Antecedentes mórbidos. Lista vacía si no se menciona ninguno.",
              "items": {
                "type": "string"
              }
            },
            "quirurgicos": {
              "type": "array",
              "description": "Antecedentes quirúrgicos. Lista vacía si no se menciona ninguno.",
              "items": {
                "type": "string"
              }
            },
            "farmacos_habituales": {
              "type": "array",
              "description": "Fármacos de uso habitual. Lista vacía si no se menciona ninguno.",
              "items": {
                "type": "string"
              }
            },
            "habitos": {
              "type": "array",
              "description": "Hábitos (tabaco, alcohol, drogas). Lista vacía si no se menciona ninguno.",
              "items": {
                "type": "string"
              }
            },
            "funcionalidad_basal": {
              "type": [
                "string",
                "null"
              ],
              "description": "Funcionalidad basal previa al ingreso."
            }
          },
          "required": [
            "morbidos",
            "quirurgicos",
            "farmacos_habituales",
            "habitos",
            "funcionalidad_basal"
          ],
          "additionalProperties": false
        },
        "apache_ii": {
          "type": [
            "number",
            "null"
          ],
          "description": "Puntaje APACHE II al ingreso."
        },
        "sofa_ingreso": {
          "type": [
            "number",
            "null"
          ],
          "description": "Puntaje SOFA al ingreso."
        },
        "limitacion_esfuerzo_terapeutico": {
          "type": [
            "string",
            "null"
          ],
          "description": "Decisiones de limitación del esfuerzo terapéutico, si existen."
        },
        "evidencia": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cita textual breve de la transcripción que respalda este dato. null si no hay cita directa."
        }
      },
