          "evidencia": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cita textual breve de la transcripción que respalda este dato. null si no hay cita directa."
          }
        },
        "required": [
          "parametro",
          "objetivo",
          "evidencia"
        ],
        "additionalProperties": false
      }
