# Template contribution working area (candidates, analyses, pristine renders, clones)
tmpl/tmp/*
!tmpl/tmp/.gitkeep

# >>> bundle (managed — do not edit by hand) >>>
bundle.manifest
# <<< bundle (managed) <<<>

# Uploaded files (audio dictations are clinical data — never commit them)
backend/apps/media/

# Local secrets (API keys) - never commit
backend/.env

# Perfiles locales con secretos generados (ver `just local init`)
local/conf/local
