# Plantilla del perfil local. NO pongas secretos reales aquí.
# `just local init` la copia a `local/conf/local` (ignorado por git) y reemplaza cada
# __GENERATED__ por un valor aleatorio. Solo para desarrollo en tu máquina; el túnel
# público (`just local tunnel-up`) sobrescribe DEBUG, el selector de cuentas y los hosts.

#=========================================#
#===== FRONTEND CONFIGURATION ============#
#=========================================#
VITE_PROXY_BACKEND_URL=http://backend:8000


#=========================================#
#===== BACKEND CONFIGURATION =============#
#=========================================#
# With DEBUG, runserver serves static straight from the staticfiles finders, so
# the Django admin's assets load in dev without a collectstatic/manifest build.
DJANGO_DEBUG=True
DJANGO_DEMO_ACCOUNT_SWITCH_ENABLED=True
DJANGO_SECRET_KEY=__GENERATED__
DJANGO_ALLOWED_HOSTS=*
# The stack is served over HTTPS at <project>.orb.local by OrbStack/Traefik.
# The admin enforces CSRF, so trust that origin for unsafe requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.orb.local
DJANGO_URL_PREFIX=-
# DJANGO_ADMINS=
# DJANGO_MEDIA_URL=/media/

# #############################
# # TIMEZONE
# #############################
# DJANGO_TIME_ZONE=UTC

# #############################
# # DATABASE CONNECTION
# #############################


DJANGO_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/webapp

# #############################
# # AUTHENTICATION
# #############################
# DJANGO_AUTH_USER_MODEL=users.User
# DJANGO_LOGIN_REDIRECT_URL=/
# DJANGO_LOGIN_URL=/admin/login/
# Sin superusuario por defecto: define estas dos variables solo si quieres uno de desarrollo.
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# #############################
# # SECURITY
# #############################
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=False

# #############################
# # EMAIL
# #############################
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_DEFAULT_FROM=webmaster@localhost
# EMAIL_SERVER=webmaster@localhost
# EMAIL_SUBJECT_PREFIX=[Django Local]

# #############################
# # LOGGING
# #############################
DJANGO_LOG_LEVEL=DEBUG


#=========================================#
#===== POSTGRES CONFIGURATION =============#
#=========================================#
POSTGRES_PORT=5432
POSTGRES_DB=webapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


#=========================================#
#===== CELERY CONFIGURATION ==============#
#=========================================#
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
